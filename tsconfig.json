{
  // 腦內江湖 TypeScript 설정 (#115) — strict + '소거 가능 문법만'(erasableSyntaxOnly):
  // 'TS는 타입만'이라는 율법(verbatimModuleSyntax와 한 쌍) — enum/namespace 같은 런타임 생성
  // 문법 금지. 원래 검사 스크립트의 맨 node import에서 비롯됐고 지금은 Vitest가 굴리지만(#166) 제약은 유지.
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, // import를 .ts 실확장자로 통일 (bundler 해석)
    "verbatimModuleSyntax": true, // import type 강제 — 스트리핑/번들러가 타입 import를 안전히 소거
    "erasableSyntaxOnly": true,
    "strict": true,
    "noEmit": true,
    // node 앰비언트 타입 명시 — 문구 정합 테스트(strings.test.ts)의 node:fs·import.meta용.
    // vite8/vitest4 업글(#197) 후 @types/node 자동 전역 포함이 끊겨 명시로 못박음(프로젝트의
    // 유일한 @types라 비용 0). vitest/vite 타입은 import로 들어와 이 목록과 무관
    "types": ["node"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true // 전환 중 .js 공존용 — 전환 완료 후에도 e2e/검사 스크립트 무해
  },
  "include": ["src/**/*"]
}
