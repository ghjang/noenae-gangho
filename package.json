{
  "name": "noenae-gangho",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "vitest run && tsc --noEmit && svelte-check --threshold error",
    "format": "prettier --write \"src/**/*.{ts,svelte}\" \"scripts/**/*.{mjs,cjs}\"",
    "prebuild": "npm run check",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^22.19.21",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
